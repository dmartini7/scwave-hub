{
  "name": "scwave-hub",
  "main": "src/worker.js",
  "compatibility_date": "2026-08-15",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    // Coaches area and its API always go through the worker (sign-in check) first.
    // The club coach code is the secret COACH_CODE, set in the Cloudflare dashboard (never in git).
    "run_worker_first": ["/", "/index.html", "/coaches", "/coaches/*", "/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "scwave-idp",
      "database_id": "3e9d8105-8bd0-4261-ac1d-dc706db80d04",
      "migrations_dir": "migrations"
    }
  ]
}
